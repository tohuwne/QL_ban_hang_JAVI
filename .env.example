# Google OAuth 2.0 Web Client ID from Google Cloud Console.
# Add http://localhost:3000 to Authorized JavaScript origins while developing locally.
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com

# Generate once: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Keep this key fixed between server restarts. Never commit the real value.
AUTH_SECRET=

# Transactional mail: Gmail requires an App Password. Never commit real credentials.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-gmail-address@gmail.com
SMTP_FROM=your-gmail-address@gmail.com
SMTP_PASS=
# Only for local OTP fixtures without SMTP. Never enable in production.
OTP_DEV_MODE=false
# Optional employee assigned to website orders (otherwise auto-select active staff).
WEB_ORDER_EMPLOYEE=

# Two independent servers sharing the same database
USER_PORT=3000
ADMIN_PORT=3001
USER_ORIGIN=http://localhost:3000
DB_SERVER=localhost\SQLEXPRESS
DB_NAME=BH_WEB2
